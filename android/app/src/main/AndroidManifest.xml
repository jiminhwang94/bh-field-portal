<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 사무실 서버와 [업데이트] 동기화 · 구글 시트 업로드에 필요 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 현장 사진 촬영 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 앱 안 [업데이트]: 내려받은 새 APK 의 설치 화면을 연다 (처음 한 번 사용자가 허용) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 카메라가 없는 기기(일부 태블릿)에서도 설치되게 한다 -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.FieldPortal"
        android:usesCleartextTraffic="false">
        <!-- usesCleartextTraffic=false (v3.49): 예전에는 사무실 서버(사내망 http)에 닿으려고 켜 두었다.
             이제 화면은 APK 안(https://appassets…), 자료는 구글(https)뿐이라 암호화 안 된 연결은 막는다. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 촬영한 사진을 WebView 로 넘길 때 쓰는 임시 파일 통로 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
